[1681.878813, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\u001b[01;32m➜  \u001b[36mProcess-Manager-Resource-Governor\u001b[00m \u001b[01;34mgit:(\u001b[31mmain\u001b[34m) \u001b[33m✗\u001b[00m \u001b[K"]
[1681.87959, "o", "\u001b[?1h\u001b="]
[1681.879755, "o", "\u001b[?2004h"]
[1854.794956, "o", "~/.local/bin/agg demo.cast demo.gif"]
[1854.917793, "o", "\u001b[18D--version         \u001b[9D"]
[1855.364451, "o", "\u001b[26Dchmod +x ~/.local/bin/agg \b"]
[1855.546742, "o", "\u001b[25Dcurl -L https://github.com/asciinema/agg/releases/download/v1.4.3/agg-x86_64-unknown-linux-gnu -o ~/.local/bin/agg"]
[1855.739177, "o", "\u001b[114Dmkdir -p\u001b[89P\u001b[13C                                                                                             \u001b[93D"]
[1855.899105, "o", "\u001b[21Dcurl -L https://github.com/asciinema/agg/releases/download/v1.4.3/agg-x86_64-unknown-linux-gnu -o ~/.local/bin/agg"]
[1856.060154, "o", "\u001b[114Dpip3 uninstall agg -y --break-system-packages                                                                     \u001b[69D"]
[1856.236596, "o", "\u001b[23D                       \u001b[24D"]
[1856.420012, "o", "\u001b[16Dshow agg | grep Location"]
[1856.76697, "o", "\u001b[29Dfind ~/.local -name \"agg\" 2>/dev/null"]
[1856.981086, "o", "\u001b[37D~/.local/bin/agg demo.cast demo.gif  \b\b"]
[1857.181602, "o", "\u001b[35D\u001b[13P\u001b[22C             \u001b[13D"]
[1857.373426, "o", "\u001b[22Dpip3 install agg --break-system-packages"]
[1857.575895, "o", "\u001b[40Dagg --version                           \u001b[27D"]
[1857.774536, "o", "\u001b[13Dls *.cast *.gif 2>/dev/null"]
[1858.095719, "o", "\u001b[27Dmv demo.gif \"C:/Users/pasel/OneDrive/Desktop/DevOps_Projects/Linux_SysAdmin/Process-Manager-Resource-Governor\""]
[1858.375393, "o", "\u001b[95D\\\u001b[5C\\\u001b[5C\\\u001b[8C\\\u001b[7C\\\u001b[15C\\\u001b[14C\\\u001b[34C"]
[1858.623589, "o", "\u001b[110Dagg demo.cast demo.gif                                                                                        \u001b[88D"]
[1858.83189, "o", "\u001b[22Dpip3 install agg --break-system-packages"]
[1859.049488, "o", "\u001b[40Dsudo apt install python3-pip -y         \u001b[9D"]
[1859.267286, "o", "\u001b[31Dexit                           \u001b[27D"]
[1859.481867, "o", "\b\b\b\byes > /dev/null &"]
[1860.074088, "o", "\u001b[17Dsudo ./procgov.sh --dry-run --duration 10 --interval 2"]
[1860.3157, "o", "\u001b[54D\u001b[5P\u001b[15Chelp                                   \u001b[35D"]
[1860.691233, "o", "\u001b[19Dscript --log-timing=timing.log typescript"]
[1861.083644, "o", "\u001b[41Dasciinema rec demo.cast                  \u001b[18D"]
[1861.315811, "o", "\u001b[23Dclear                  \u001b[18D"]
[1861.587638, "o", "\b\b\b\b\bsudo apt update && sudo apt install asciinema -y"]
[1861.90744, "o", "\u001b[48Dclear                                           \u001b[43D"]
